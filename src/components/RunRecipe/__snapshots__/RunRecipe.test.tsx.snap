      mod config recipes npm install @openrewrite/recipes-npm
    </pre>
    <p>
      Then, you can run the recipe via:
    </p>
    <pre>
      mod run . --recipe org.openrewrite.npm.Find
    </pre>
  </main>
</DocumentFragment>

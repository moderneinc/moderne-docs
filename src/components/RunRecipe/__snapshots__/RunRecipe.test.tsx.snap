exports[`RunRecipe > optional settings > renders a pip recipe unchanged without optional settings 1`] = `
<DocumentFragment>
  <main>
    <p>
      In order to run Python recipes, you will need to use the 
      <a
        href="https://docs.moderne.io/user-documentation/moderne-cli/getting-started/cli-intro"
      >
        Moderne CLI
      </a>
      .
    </p>
    <p>
      Once the CLI is installed, you can install this Python recipe package by running the following command:
    </p>
    <pre>
      mod config recipes pip install openrewrite-migrate-python
    </pre>
    <p>
      Then, you can run the recipe via:
    </p>
    <pre>
      mod run . --recipe org.openrewrite.python.migrate.UpgradeToPython314 --recipe-option "methodPattern=dumps(..)"
    </pre>
  </main>
</DocumentFragment>
`;
